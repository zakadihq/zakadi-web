    "@zakadi/protocol": "0.1.0",
    "happy-dom": "^20.14.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "peerDependencies": {
    "@zakadi/web-core": "0.0.0"
  }
}
