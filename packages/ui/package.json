{
  "name": "@zakadi/ui",
  "version": "0.0.0",
  "description": "Zakadi default UI: the <zakadi-call> custom element of the face-liveness call.",
  "scripts": {
    "test": "vitest run",
    "build": "vite build && tsc6 -p tsconfig.build.json",
    "lint": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zakadihq/zakadi-web.git",
    "directory": "packages/ui"
  },
  "sideEffects": [
    "./dist/define.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
